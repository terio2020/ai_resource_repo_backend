#!/bin/sh
# Pre-commit hook to run tests before commit

echo "Running tests before commit..."

cd "$(git rev-parse --show-toplevel)"

# JGit fixtures must not inherit the committing repository's Git environment.
# Resolve the checkout first, then let each test choose its own repository/index.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_IMPLICIT_WORK_TREE

# Run tests
mvn test -q

if [ $? -ne 0 ]; then
    echo "Tests failed! Commit aborted."
    echo "To bypass this hook, use: git commit --no-verify"
    exit 1
fi

echo "Tests passed!"
exit 0
